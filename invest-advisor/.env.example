# Скопируйте в .env и заполните. НЕ коммитьте .env с реальным токеном!

# Токен доступа T-Invest. Рекомендуется выпустить токен ТОЛЬКО НА ЧТЕНИЕ
# (read-only) в личном кабинете Тинькофф Инвестиций:
#   Настройки -> Токены для API -> создать токен -> "только чтение".
TINVEST_TOKEN=

# Необязательно: id конкретного счёта. Если пусто — берётся первый доступный.
TINVEST_ACCOUNT_ID=

# "1" для работы через песочницу (Sandbox), иначе боевой контур.
TINVEST_USE_SANDBOX=0

# Базовая валюта отчёта.
TINVEST_BASE_CURRENCY=RUB
